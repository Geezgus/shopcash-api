NODE_ENV=development
LOG_LEVEL=log

API_PORT=3000
API_DOCS_ENABLED=true
# Comma-separated. When unset, any origin is allowed outside production.
# CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=100

DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=shopcash
DATABASE_RUN_MIGRATIONS=true
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Generate with: openssl rand -base64 48
TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_ACCESS_TOKEN_TTL_SECONDS=3600

# First super admin, created on startup if it does not exist.
SYSADMIN_NAME=Admin
SYSADMIN_EMAIL=admin@shopcash.com
SYSADMIN_PASSWORD=AdminP4$$
